# ====================================
# SOCIALCLUBS - ENVIRONMENT VARIABLES
# ====================================

# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# ====================================
# SUPABASE
# ====================================
# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ====================================
# DAILY.CO (VIDEOCALLS)
# ====================================
# Get your API key from: https://dashboard.daily.co/developers
DAILY_API_KEY=your-daily-api-key-here
NEXT_PUBLIC_DAILY_DOMAIN=your-subdomain.daily.co

# ====================================
# CRON JOB AUTHENTICATION
# ====================================
# Generate a random secret for cron job authentication
# Example: openssl rand -base64 32
CRON_SECRET=your-random-secret-here

# ====================================
# STRIPE (PAYMENTS) - Optional for now
# ====================================
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ====================================
# ANALYTICS & SUPPORT
# ====================================
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_CRISP_WEBSITE_ID=your-crisp-website-id

# ====================================
# EMAIL
# ====================================
RESEND_API_KEY=re_your-resend-api-key

# ====================================
# MUX (VIDEO INFRASTRUCTURE)
# ====================================
# Get your token from: https://dashboard.mux.com/settings/access-tokens
# Create a new token with permissions: Mux Video (Full Access)
MUX_TOKEN_ID=your-mux-token-id-here
MUX_TOKEN_SECRET=your-mux-token-secret-here

# Webhook signing secret (for verifying webhooks)
# Get from: https://dashboard.mux.com/settings/webhooks
# Create webhook pointing to: https://your-domain.com/api/webhooks/mux
# Select events: video.asset.ready, video.asset.errored, video.upload.asset_created
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret-here

# ====================================
# UPSTASH REDIS (Rate limiting + Cache)
# ====================================
# Create a Redis database at: https://console.upstash.com
# Select the same region as your Vercel deployment
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ====================================
# UPSTASH QSTASH (Background job queue)
# ====================================
# Get your keys from the QStash section at: https://console.upstash.com
# Worker endpoint: /api/queues/gamification
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=sig_your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=sig_your-next-signing-key

# ====================================
# ONESIGNAL (PUSH NOTIFICATIONS)
# ====================================
# Create an app at: https://dashboard.onesignal.com
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# ====================================
# SUPABASE DATABASE WEBHOOK
# ====================================
# Secret shared between Supabase and Vercel to authenticate webhook calls.
# Generate with: openssl rand -base64 32
# Configure in: Supabase Dashboard → Database → Webhooks → notifications_push
#   Table: notifications | Events: INSERT
#   URL: https://your-app.vercel.app/api/notifications/push
#   Header: x-webhook-secret = <this value>
SUPABASE_WEBHOOK_SECRET=your-random-secret-here

# ====================================
# SITE CONFIGURATION
# ====================================
# Used by QStash to build the callback URL for the gamification worker
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

