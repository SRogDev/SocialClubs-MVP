# ====================================
# SOCIALCLUBS - ENVIRONMENT VARIABLES
# ====================================

# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# ====================================
# SUPABASE
# ====================================
# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Service-role key — server-side ONLY (never NEXT_PUBLIC_*). Used by the AI
# runtime (lib/ai/cost.ts) to log usage and enforce per-club budgets.
# Get it from: project settings > API > service_role (keep it secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ====================================
# DAILY.CO (VIDEOCALLS)
# ====================================
# Get your API key from: https://dashboard.daily.co/developers
DAILY_API_KEY=your-daily-api-key-here
NEXT_PUBLIC_DAILY_DOMAIN=your-subdomain.daily.co

# ====================================
# CRON JOB AUTHENTICATION
# ====================================
# Generate a random secret for cron job authentication
# Example: openssl rand -base64 32
CRON_SECRET=your-random-secret-here

# ====================================
# STRIPE (PAYMENTS) - Optional for now
# ====================================
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ====================================
# ANALYTICS & SUPPORT
# ====================================
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_CRISP_WEBSITE_ID=your-crisp-website-id

# ====================================
# EMAIL
# ====================================
RESEND_API_KEY=re_your-resend-api-key

# ====================================
# MUX (VIDEO INFRASTRUCTURE)
# ====================================
# Get your token from: https://dashboard.mux.com/settings/access-tokens
# Create a new token with permissions: Mux Video (Full Access)
MUX_TOKEN_ID=your-mux-token-id-here
MUX_TOKEN_SECRET=your-mux-token-secret-here

# Webhook signing secret (for verifying webhooks)
# Get from: https://dashboard.mux.com/settings/webhooks
# Create webhook pointing to: https://your-domain.com/api/webhooks/mux
# Select events: video.asset.ready, video.asset.errored, video.upload.asset_created
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret-here

# ====================================
# UPSTASH REDIS (Rate limiting + Cache)
# ====================================
# Create a Redis database at: https://console.upstash.com
# Select the same region as your Vercel deployment
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ====================================
# UPSTASH QSTASH (Background job queue)
# ====================================
# Get your keys from the QStash section at: https://console.upstash.com
# Worker endpoints: /api/queues/gamification, /api/queues/ai-signals
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=sig_your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=sig_your-next-signing-key

# ====================================
# AI SIGNALS (lib/ai/signals.ts)
# ====================================
# The AI signal layer needs NO extra variables: dispatchSignal() derives the
# worker URL as ${NEXT_PUBLIC_SITE_URL}/api/queues/ai-signals and reuses the
# QSTASH_TOKEN + signing keys above.
#
# Dev mode: when QSTASH_TOKEN (or NEXT_PUBLIC_SITE_URL) is unset, signals are
# still persisted to the ai_signals table but delivery is skipped with a log
# line — the user-facing action never blocks on the queue.
#
# Signals are deduplicated by dedup_key inside a 24h window (emitSignal);
# the worker marks each row processed_at after routing it through the
# governance pipeline (verifyAndExecute). At proactivity L1 every signal
# action lands as a DRAFT for the AI Inbox — nothing is auto-sent.

# ====================================
# INTERNAL WORKER AUTHENTICATION
# ====================================
# Secret that proves a call to a system-only service function comes from our
# own workers (e.g. the QStash gamification worker calling awardPoints()).
# The worker route passes it; services verify it via requireInternalWorker()
# in lib/authz.ts. Generate with: openssl rand -base64 32
INTERNAL_WORKER_SECRET=<redacted>

# ====================================
# ONESIGNAL (PUSH NOTIFICATIONS)
# ====================================
# Create an app at: https://dashboard.onesignal.com
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# ====================================
# SUPABASE DATABASE WEBHOOK
# ====================================
# Secret shared between Supabase and Vercel to authenticate webhook calls.
# Generate with: openssl rand -base64 32
# Configure in: Supabase Dashboard → Database → Webhooks → notifications_push
#   Table: notifications | Events: INSERT
#   URL: https://your-app.vercel.app/api/notifications/push
#   Header: x-webhook-secret = <this value>
SUPABASE_WEBHOOK_SECRET=your-random-secret-here

# ====================================
# SITE CONFIGURATION
# ====================================
# Used by QStash to build the callback URL for the gamification worker
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ====================================
# AI STAFF (AIsa LLM PROVIDER)
# ====================================
# All AI-staff LLM calls go through the shared runtime in lib/ai/
# (see docs/adr/ADR-001-ai-runtime.md). AIsa is OpenAI-compatible:
# POST https://api.aisa.one/v1/chat/completions

# When AISA_API_KEY is absent, the runtime uses a deterministic mock adapter
# (schema-valid canned JSON, zero tokens) — dev/test/CI work offline.
# Get your key from: https://aisa.one (dashboard)
AISA_API_KEY=

# Model routing by tier (ADR-001 §2). Defaults are documented in
# lib/ai/models.ts — VERIFY them against AIsa's live model list before
# production use; override here to pin exact model ids.
AISA_MODEL_FAST=
AISA_MODEL_SMART=
AISA_MODEL_REVIEWER=

# Default per-club monthly AI budget in USD. A club's ai_budgets row is
# auto-created on first use with this cap; when the cap is hit the runtime
# throws AI_BUDGET_EXCEEDED before calling the model (graceful degradation).
AI_MONTHLY_BUDGET_USD_DEFAULT=5

# Feature flags — ALL default OFF (unset = disabled).
# AI_STAFF_ENABLED is the master kill switch: an agent runs only when the
# master flag AND its own flag are both on (lib/ai/flags.ts).
AI_STAFF_ENABLED=
AI_COMMUNITY_MANAGER=
AI_EXPERIENCE_DIRECTOR=
AI_CREATOR_COPILOT=
AI_INBOX=
AI_MODERATION=
AI_SENTIENT_UI=
AI_WIDGETS=

