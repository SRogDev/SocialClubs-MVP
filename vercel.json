{
    "$schema": "https://turbo.build/schema.json",
    "buildCommand": "next build",
    "framework": "nextjs",
    "installCommand": "pnpm install",
    "devCommand": "pnpm dev",
    "outputDirectory": ".next",
    "crons": [
        {
            "path": "/api/cron/check-appointments",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron/ai-digest",
            "schedule": "0 9 * * 1"
        },
        {
            "path": "/api/cron/ai-briefing",
            "schedule": "0 12 * * *"
        }
    ]
}